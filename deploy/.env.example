# 复制为 .env 后填写。密码和密钥用下面的命令生成：openssl rand -hex 32
# 密码里不要包含 @ : / ? # 这些字符，它们会破坏连接串的格式（十六进制串没有这个问题）。

# ===== 域名 =====
API_DOMAIN=api.example.com
SIGNAL_DOMAIN=signal.example.com
RELAY_DOMAIN=relay-01.example.com
# 申请证书用的邮箱，证书快到期时会收到提醒
ACME_EMAIL=ops@example.com

# ===== 镜像版本 =====
IMAGE_TAG=1.0.0

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=换成随机字符串
MYSQL_DATABASE=rterm
MYSQL_USER=rterm
MYSQL_PASSWORD=换成随机字符串

# ===== Redis =====
REDIS_PASSWORD=换成随机字符串

# ===== 服务端密钥 =====
# 票据签名密钥，信令和中继必须一致（至少 16 个字符）
TICKET_SECRET=换成随机字符串
# 轮换密钥时把旧密钥放这里，平时留空
TICKET_SECRET_OLD=
# 管理接口的访问令牌
ADMIN_TOKEN=换成随机字符串

# ===== 中继节点 =====
RELAY_NODE_NAME=relay-01
RELAY_REGION=cn-east

# ===== 客户端版本控制（可选，也可以用管理接口写入 app_config） =====
# 低于此版本的客户端登录信令时会收到强制升级通知
MIN_APP_VERSION=1.0.0

# ===== 其他 =====
LOG_LEVEL=info
