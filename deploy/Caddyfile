{
	email {$ACME_EMAIL}
}

# HTTP API
{$API_DOMAIN} {
	encode gzip
	# 管理接口和指标不对公网开放（通过 SSH 隧道访问）
	@internal path /v1/admin /v1/admin/* /metrics
	respond @internal 404
	reverse_proxy signal:8080
}

# 信令 WebSocket：这个域名只需要 /v1/signal，其余路径一律 404，
# 这样管理接口和指标不会从信令域名漏出去
{$SIGNAL_DOMAIN} {
	handle /v1/signal {
		reverse_proxy signal:8080
	}
	handle {
		respond 404
	}
}

# 中继 WebSocket：只放行 /v1/relay 和健康检查，/metrics 不对外
{$RELAY_DOMAIN} {
	handle /v1/relay {
		reverse_proxy relay:8081
	}
	handle /healthz {
		reverse_proxy relay:8081
	}
	handle {
		respond 404
	}
}

# Web 版界面（静态文件，由 ../apps/desktop 用 `npm run build:web` 构建，内容放在 deploy/web/）。
# 同一个域名下把 /v1/* 反代到 API，浏览器当同源请求，不需要 CORS；管理接口和指标照样不放行。
# 信令和中继的 WebSocket 由页面直接连 SIGNAL_DOMAIN / RELAY_DOMAIN。
# 设备私钥保存在浏览器里，所以 CSP 收得很紧：只允许加载本站脚本，不允许内联脚本。
# 没配置 WEB_DOMAIN 时退回 localhost（只在容器内生效，不会去申请证书）。
{$WEB_DOMAIN:localhost} {
	encode zstd gzip
	handle /v1/* {
		# 指令顺序：respond 先于 reverse_proxy，管理接口在这里就被挡住
		@internal path /v1/admin /v1/admin/*
		respond @internal 404
		reverse_proxy signal:8080
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/web
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}
}
